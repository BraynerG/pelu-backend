{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ],
  "outputFileTracingIncludes": {
    "api/index.ts": ["node_modules/.prisma/**", "node_modules/@prisma/client/**"]
  }
}
